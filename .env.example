NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Shipping gateway (P2/P3/P4) : SERVER-ONLY, never prefix with NEXT_PUBLIC_ ---
# 32 random bytes, base64 or hex. Generate: openssl rand -base64 32
SHIPPING_MASTER_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# P3/P4 offline Mock Fetch for Yalidine + ZR Procolis + ZR new platform.
# Set to false only after official Sandbox keys/docs are saved; the adapters do
# not change. No real Sandbox keys are configured in this checkout.
SHIPPING_MOCK_MODE=true

# HMAC-SHA256 secrets for signed courier webhooks. Generate:
# openssl rand -hex 24
# In Mock Mode the gateway falls back to its fixed local mock secret.
SHIPPING_YALIDINE_WEBHOOK_SECRET=
# SHIPPING_ZREXPRESS_WEBHOOK_SECRET=
# SHIPPING_ZREXPRESSNEW_WEBHOOK_SECRET=

# Optional per-provider/per-environment API roots. Without one, live mode falls
# back to the provider default (Yalidine: https://api.yalidine.app/v1/).
# ZR Procolis and ZR new platform have NO safe default: set these explicitly
# after receiving the official Sandbox documentation.
# SHIPPING_YALIDINE_SANDBOX_BASE_URL=
# SHIPPING_YALIDINE_PRODUCTION_BASE_URL=
# SHIPPING_ZREXPRESS_SANDBOX_BASE_URL=
# SHIPPING_ZREXPRESS_PRODUCTION_BASE_URL=
# SHIPPING_ZREXPRESSNEW_SANDBOX_BASE_URL=
# SHIPPING_ZREXPRESSNEW_PRODUCTION_BASE_URL=
# SHIPPING_PROBE_TIMEOUT_MS=8000

# --- POS thermal printing (P5) : SERVER-ONLY, never prefix with NEXT_PUBLIC_ ---
# Optional HTTP(S) endpoint of a print middleware that accepts raw ESC/POS bytes
# as application/octet-stream. The browser calls the relative route
# /api/printing/relay; it can never choose the destination URL itself.
# Leave empty to use WebUSB, WebBluetooth or shaped browser printing.
# PRINT_MIDDLEWARE_URL=
# PRINT_MIDDLEWARE_TOKEN=
